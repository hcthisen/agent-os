{
  "mcpServers": {
    "agent-os": {
      "command": "node",
      "args": ["apps/mcp/dist/index.js"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}",
        "AGENT_ID": "${AGENT_ID}",
        "ROLE_ID": "${ROLE_ID}",
        "RUN_ID": "${RUN_ID}",
        "TRACE_ID": "${TRACE_ID}"
      }
    }
  }
}
