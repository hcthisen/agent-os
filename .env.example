# ============================================================================
# Agent-OS - VPS Environment Variables
#
# For direct VPS deployments, run `bash scripts/install-vps.sh`.
# The installer prompts for whether to add a domain, the admin username,
# admin password, and optional Telegram bot token, then writes
# a local `.env.vps` file.
#
# If you enable domain setup, the root domain must already point at the VPS with:
# - an A record for the root domain
# - a wildcard A record for `*.domain.com`
#
# Everything else (passwords, JWT secret, Supabase keys)
# is auto-generated on first boot unless explicitly set below.
# ============================================================================

# Root domain served by Caddy on the VPS. Leave blank when domain setup is skipped.
ROOT_DOMAIN=

# Public URLs derived from the root domain. Leave blank when domain setup is skipped.
ADMIN_PUBLIC_URL=
PUBLIC_SITE_URL=

# Admin bind settings. With domain setup enabled, bind to 127.0.0.1 behind Caddy.
# Without a domain, bind to 0.0.0.0 so the dashboard is reachable on localhost or IP:3000.
ADMIN_LOCAL_PORT=3000
ADMIN_BIND_HOST=127.0.0.1

# Optional Caddy settings. Disable when domain setup is skipped.
CADDY_ENABLED=true
CADDY_SITE_SNIPPETS_DIR=/srv/agent-os/caddy/sites
CADDY_DATA_DIR=/srv/agent-os/caddy/data
CADDY_CONFIG_DIR=/srv/agent-os/caddy/config

# Telegram (optional - set to enable Telegram inbound/outbound)
TELEGRAM_BOT_TOKEN=

# Admin login (the VPS installer prompts for these; if left unset,
# they are generated on first boot and stored in the config volume).
ADMIN_USER=
ADMIN_PASS=
