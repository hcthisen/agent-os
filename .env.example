# ============================================================================
# Agent-OS — Coolify Environment Variables
#
# Only these need to be set manually. Everything else (passwords, JWT secret,
# Supabase keys, admin credentials) is auto-generated on first boot.
# ============================================================================

# Domains (required)
ADMIN_DOMAIN=admin.example.com
PUBLIC_DOMAIN=example.com

# Telegram (optional — leave empty to skip)
TELEGRAM_BOT_TOKEN=
