# ============================================================================
# Agent-OS — Coolify Environment Variables
#
# Domains are configured in Coolify's Domains UI per service, not as env vars.
# Everything else (passwords, JWT secret, Supabase keys)
# is auto-generated on first boot unless explicitly set below.
# ============================================================================

# Telegram (optional — set in Coolify to enable Telegram inbound/outbound)
TELEGRAM_BOT_TOKEN=

# Admin login (optional — if unset, generated on first boot and stored in the
# config volume. If set in Coolify, these values override the generated ones.)
ADMIN_USER=
ADMIN_PASS=
