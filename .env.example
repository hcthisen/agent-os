# ============================================================================
# Agent-OS — Coolify Environment Variables
#
# Domains are configured in Coolify's Domains UI per service, not as env vars.
# Everything else (passwords, JWT secret, Supabase keys, admin credentials)
# is auto-generated on first boot.
# ============================================================================

# Telegram (optional — set in Coolify to enable Telegram inbound/outbound)
TELEGRAM_BOT_TOKEN=
